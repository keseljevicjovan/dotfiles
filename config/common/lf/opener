#!/bin/sh

file="$1"
mime=$(file --mime-type -Lb "$file")

open_image(){ 
    if [ -n "$WAYLAND_DISPLAY" ]; then
        exec swayimg "$file"
    else
        exec nsxiv -ba "$file"
    fi
}

case "$file" in
    *.m3u|*.m3u8) exec mpv "$file" ;;
esac

case "$mime" in
    text/*)     exec nvim "$file" ;;
    text/html)  exec firefox "$file" ;;
    image/*)    open_image ;;
    audio/*)    exec mpv "$file" ;;
    video/*)    exec mpv "$file" ;;
    application/pdf) zathura "$file" ;;
    *)          exec xdg-open "$file" ;;
esac
